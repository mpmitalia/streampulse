# Data files — too large for git, regenerate via notebook/01_data_generation.ipynb
data/*.csv
data/*.csv.gz

# The cloned Apache Superset source (from the Docker setup attempt) — not your code
superset/superset/
superset/docker-compose*.yml
superset/Dockerfile
superset/*.md
superset/requirements*
superset/setup.py
superset/pyproject.toml
superset/superset-frontend/
superset/superset-websocket/
superset/tests/
superset/scripts/
superset/docker/

# Keep only your own exported dashboard JSON + screenshots in superset/
!superset/*.json
!superset/*.png
!superset/*.jpg
!superset/README.md

